rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ⚙️ إعدادات التطبيق وتحديثات الإصدار (قراءة للجميع وتحديث موثوق)
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // 👤 بيانات المستخدمين وسجل الأصدقاء
    match /users/{userId} {
      allow read, write: if true;
      
      match /friends/{friendId} {
        allow read, write: if true;
      }
    }

    // 📧 حسابات جوجل المسجلة
    match /gmail_users/{emailDoc} {
      allow read, write: if true;
    }

    // 🛡️ أي مستندات أو مجموعات أخرى مستقبلاً في التطبيق
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
